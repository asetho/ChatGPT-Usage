<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\ChatGPTUsage.ico</ApplicationIcon>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="InstallUpdate.ps1" LogicalName="ChatGPTUsage.InstallUpdate.ps1" />
    <Content Include="Assets\ChatGPTUsage.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="Assets\ChatGPTUsage-small.png" />
    <EmbeddedResource Include="../CodexUsage/Assets.xcassets/Lucide*.imageset/*.svg;../CodexUsage/Assets.xcassets/UsageGauge.imageset/*.svg;../CodexUsage/Assets.xcassets/GitHubMark.imageset/*.svg">
      <LogicalName>Lucide.%(Filename).svg</LogicalName>
    </EmbeddedResource>
    <Content Include="../CodexUsage/Resources/Lucide-LICENSE.txt" Link="Lucide-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
