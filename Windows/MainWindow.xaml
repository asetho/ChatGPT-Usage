<Window x:Class="ChatGPTUsage.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ChatGPTUsage.Windows"
        Width="330" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" Topmost="True" Background="Transparent"
        AllowsTransparency="True" Deactivated="Window_Deactivated"
        Loaded="Window_Loaded" SizeChanged="Window_SizeChanged">
    <Border x:Name="RootBorder" Background="#14171D" BorderBrush="#414650" BorderThickness="1" CornerRadius="14" Padding="18">
        <DockPanel LastChildFill="True">
            <StackPanel x:Name="FooterPanel" DockPanel.Dock="Bottom" Margin="0,8,0,0"
                        SizeChanged="LayoutPart_SizeChanged">
                <StackPanel Visibility="{Binding UpdateAvailableVisibility}" Margin="0,0,0,12">
                    <Border Background="#202A38" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Update available" FontSize="14" FontWeight="SemiBold" Foreground="#F0F1F4" />
                                <TextBlock Text="{Binding UpdateDescription}" FontSize="12" Foreground="#B4B8C0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Content="Update now" Click="InstallUpdate_Click" IsEnabled="{Binding CanInstallUpdate}"
                                        Visibility="{Binding InstallUpdateVisibility}" Padding="6,3" Margin="0,0,10,0"
                                        Background="#2563A6" Foreground="White"
                                        AutomationProperties.HelpText="Downloads the update, installs it, and reopens the app" />
                                <Button Content="View release" Click="OpenUpdate_Click" Padding="0" Background="Transparent"
                                        Foreground="#9BC5FF" />
                            </StackPanel>
                            <StackPanel Visibility="{Binding UpdateProgressVisibility}" Margin="0,8,0,0">
                                <TextBlock Text="{Binding UpdateInstallStatus}" Foreground="#B4B8C0" FontSize="12" TextWrapping="Wrap" />
                                <ProgressBar IsIndeterminate="True" Height="3" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="{Binding UpdateInstallError}" Visibility="{Binding UpdateInstallErrorVisibility}"
                           Foreground="#E9B267" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,12" />

                <Separator Background="#414650" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding RefreshStatus}" Foreground="#858B96" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RefreshStatus}" Margin="0,0,8,0" />
                    <Button Grid.Column="1" Click="Refresh_Click" Padding="0,3" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE"
                            ToolTip="Refresh usage" AutomationProperties.Name="Refresh">
                        <StackPanel Orientation="Horizontal">
                            <local:SymbolIcon Kind="Refresh" Width="14" Height="14" Foreground="#E6E8EE" Margin="0,0,5,0" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Content="Quit" Click="Quit_Click" Margin="12,0,0,0" FontSize="12"
                            Padding="0,3" Background="Transparent" BorderThickness="0" Foreground="#E6E8EE" />
                </Grid>
            </StackPanel>

            <ScrollViewer x:Name="ContentScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ContentStack" SizeChanged="LayoutPart_SizeChanged">
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <local:SymbolIcon Kind="Gauge" Width="24" Height="24" Margin="0,0,10,0" Foreground="#AEB4BE" />
                            <TextBlock Text="Usage remaining" FontSize="18" FontWeight="SemiBold" Foreground="#F0F1F4" VerticalAlignment="Center" />
                        </StackPanel>
                        <Button Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings"
                                HorizontalAlignment="Right" Padding="5,1" Background="Transparent" BorderThickness="0" Foreground="#B4B8C0">
                            <local:SymbolIcon Kind="Settings" Width="18" Height="18" Foreground="#B4B8C0" />
                        </Button>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Weekly" FontSize="17" Foreground="#F0F1F4" />
                        <TextBlock Grid.Column="1" Text="{Binding WeeklyRemaining}" FontSize="17" Foreground="#B4B8C0" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding WeeklyReset}" Margin="0,3,0,0"
                                   FontSize="13" Foreground="#858B96" />
                    </Grid>

                    <Button Click="OpenUsage_Click" Padding="0,5" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#F0F1F4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding ResetTitle}" FontSize="16" />
                                <TextBlock Text="{Binding ResetExpiration}" Visibility="{Binding ResetExpirationVisibility}"
                                           FontSize="12" Foreground="#858B96" Margin="0,2,0,0" />
                            </StackPanel>
                            <local:SymbolIcon Grid.Column="1" Kind="ExternalLink" Width="14" Height="14" Foreground="#B4B8C0" Margin="6,0,0,0" />
                        </Grid>
                    </Button>

                    <Separator Background="#414650" Margin="0,12,0,8" />
                    <Expander Header="Additional limits" Visibility="{Binding AdditionalLimitsVisibility}" Foreground="#F0F1F4" FontSize="16" Margin="0,0,0,8"
                              Expanded="Disclosure_Changed" Collapsed="Disclosure_Changed">
                        <ItemsControl ItemsSource="{Binding AdditionalLimits}" Margin="18,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="#B4B8C0" FontSize="13"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Button Click="OpenReserveGuide_Click" Visibility="{Binding GuideVisibility}"
                                                    ToolTip="Read the Luna Reserve guide" AutomationProperties.Name="Read the Luna Reserve guide"
                                                    Background="Transparent" BorderThickness="0" Foreground="#B4B8C0"
                                                    Padding="4,2" Margin="2,0,0,0">
                                                <local:SymbolIcon Kind="Help" Width="15" Height="15" Foreground="#B4B8C0" />
                                            </Button>
                                        </StackPanel>

                                        <Grid Visibility="{Binding FiveHourVisibility}" Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="5h" Foreground="#E6E8EE" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="{Binding FiveHourReset}"
                                                       Foreground="#B4B8C0" FontSize="12" Margin="10,1,10,0"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{Binding FiveHourRemaining}"
                                                       Foreground="#F0F1F4" FontSize="14" FontWeight="SemiBold"
                                                       TextAlignment="Right" />
                                        </Grid>

                                        <Grid Visibility="{Binding WeeklyVisibility}" Margin="0,5,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="52" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Weekly" Foreground="#E6E8EE" FontSize="14" />
                                            <TextBlock Grid.Column="1" Text="{Binding WeeklyRemaining}"
                                                       Foreground="#F0F1F4" FontSize="14" FontWeight="SemiBold"
                                                       TextAlignment="Right" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding WeeklyReset}"
                                                       Foreground="#858B96" FontSize="12" Margin="0,2,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                    <Expander x:Name="TokenUsageExpander" Header="Token usage" Visibility="{Binding TokenUsageVisibility}" Foreground="#F0F1F4" FontSize="16"
                              Expanded="Disclosure_Changed" Collapsed="Disclosure_Changed">
                        <ItemsControl ItemsSource="{Binding TokenUsage}" Margin="18,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" Foreground="#B4B8C0" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#E6E8EE" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB86C" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="Margin" Value="0,12,0,0" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Margin" Value="0" />
                                    </Trigger>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Margin" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
